{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noEmit": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@work-engine/kernel": ["packages/kernel/src/index.ts"],
      "@work-engine/protocol": ["packages/protocol/src/index.ts"],
      "@work-engine/runtime": ["packages/runtime/src/index.ts"],
      "@work-engine/cloudflare": ["packages/cloudflare/src/index.ts"],
      "@work-engine/session-host": ["packages/session-host/src/index.ts"],
      "@work-engine/control-plane": ["apps/control-plane/src/index.ts"],
      "@work-engine/cli": ["apps/cli/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "infra/**/*.ts",
    "scripts/**/*.ts",
    "commitlint.config.ts",
    "vitest.config.ts",
    "wrangler.*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    ".wrangler",
    ".alchemy",
    "fixtures"
  ]
}
